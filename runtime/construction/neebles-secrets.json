{
  "schema": "1",
  "name": "neebles-domestic-construction",
  "subject": "neebles-secrets",
  "rootfs": {
    "rust-qt": {
      "domination": {
        "world": "modules.rust-qt"
      }
    },
    "keepass-full": {
      "domination": {
        "world": "modules.rust-qt"
      }
    },
    "keepass-minimal": {
      "domination": {
        "world": "modules.rust-qt"
      }
    }
  },
  "steps": [
    {
      "id": "init",
      "runtime_authority": "boss.runtime",
      "world": "boss.git",
      "writable": [
        {
          "authority": "neebles.domestic_workspace",
          "source": "/opt/neebles-build/modules",
          "destination": "/work/modules"
        }
      ],
      "mounts": {
        "proc": true,
        "dev": true,
        "tmp": true
      },
      "chdir": "/work/modules",
      "arguments": [
        "init",
        "/work/modules/neebles-secrets"
      ],
      "session": false,
      "execution": "foreground"
    },
    {
      "id": "fetch",
      "runtime_authority": "boss.runtime",
      "world": "boss.git",
      "readonly": [
        "system.dns_resolver_config"
      ],
      "writable": [
        {
          "authority": "neebles.domestic_workspace",
          "source": "/opt/neebles-build/modules",
          "destination": "/work/modules"
        }
      ],
      "mounts": {
        "proc": true,
        "dev": true,
        "tmp": true
      },
      "chdir": "/work/modules",
      "arguments": [
        "-C",
        "/work/modules/neebles-secrets",
        "fetch",
        "--depth",
        "1",
        "https://github.com/krockzs/neebles-secrets.git",
        "5a069633763b93c3932166442d4b936493f0d4c3"
      ],
      "session": false,
      "execution": "foreground"
    },
    {
      "id": "checkout",
      "runtime_authority": "boss.runtime",
      "world": "boss.git",
      "writable": [
        {
          "authority": "neebles.domestic_workspace",
          "source": "/opt/neebles-build/modules",
          "destination": "/work/modules"
        }
      ],
      "mounts": {
        "proc": true,
        "dev": true,
        "tmp": true
      },
      "chdir": "/work/modules",
      "arguments": [
        "-C",
        "/work/modules/neebles-secrets",
        "checkout",
        "--detach",
        "5a069633763b93c3932166442d4b936493f0d4c3"
      ],
      "session": false,
      "execution": "foreground"
    },
    {
      "id": "open-ui",
      "runtime_authority": "modules.runtime",
      "rootfs": "rust-qt",
      "world": "modules.rust-qt",
      "execution": "persistent",
      "session": true,
      "readonly": [
        "boss.modules.ipc"
      ],
      "dynamic_readonly": [
        {
          "authority": "modules.installed_runtime",
          "source": "/opt/neebles/modules/neebles-secrets",
          "destination": "/opt/neebles/modules/neebles-secrets"
        }
      ],
      "mounts": {
        "proc": true,
        "dev": true,
        "tmp": true
      },
      "chdir": "/opt/neebles/modules/neebles-secrets",
      "arguments": [
        "/opt/neebles/modules/neebles-secrets/runtime/neebles-secrets-ui",
        "--intent",
        "open"
      ],
      "session_readonly": [
        "neebles-secrets/secrets.sock"
      ]
    }
  ]
}
