{
  "schema": "1",
  "name": "neebles-domestic-construction",
  "subject": "test-module",
  "steps": [
    {
      "id": "init",
      "runtime_authority": "boss.runtime",
      "world": "boss.git",
      "writable": [
        {
          "authority": "neebles.domestic_workspace",
          "source": "/opt/neebles-build/modules",
          "destination": "/work/modules"
        }
      ],
      "mounts": {
        "proc": true,
        "dev": true,
        "tmp": true
      },
      "chdir": "/work/modules",
      "arguments": [
        "init",
        "/work/modules/test-module"
      ],
      "session": false,
      "execution": "foreground"
    },
    {
      "id": "fetch",
      "runtime_authority": "boss.runtime",
      "world": "boss.git",
      "readonly": [
        "system.dns_resolver_config"
      ],
      "writable": [
        {
          "authority": "neebles.domestic_workspace",
          "source": "/opt/neebles-build/modules",
          "destination": "/work/modules"
        }
      ],
      "mounts": {
        "proc": true,
        "dev": true,
        "tmp": true
      },
      "chdir": "/work/modules",
      "arguments": [
        "-C",
        "/work/modules/test-module",
        "fetch",
        "--depth",
        "1",
        "https://github.com/krockzs/neebles-test-module.git",
        "308fbf186aa9dc2a2201862f993809799a987fd0"
      ],
      "session": false,
      "execution": "foreground"
    },
    {
      "id": "checkout",
      "runtime_authority": "boss.runtime",
      "world": "boss.git",
      "writable": [
        {
          "authority": "neebles.domestic_workspace",
          "source": "/opt/neebles-build/modules",
          "destination": "/work/modules"
        }
      ],
      "mounts": {
        "proc": true,
        "dev": true,
        "tmp": true
      },
      "chdir": "/work/modules",
      "arguments": [
        "-C",
        "/work/modules/test-module",
        "checkout",
        "--detach",
        "308fbf186aa9dc2a2201862f993809799a987fd0"
      ],
      "session": false,
      "execution": "foreground"
    },
    {
      "id": "open-runtime",
      "runtime_authority": "modules.runtime",
      "world": "modules.python3.13-tk",
      "execution": "persistent",
      "session": true,
      "readonly": [
        "boss.modules.ipc"
      ],
      "dynamic_readonly": [
        {
          "authority": "modules.installed_runtime",
          "source": "/opt/neebles/modules/test-module",
          "destination": "/opt/neebles/modules/test-module"
        }
      ],
      "mounts": {
        "proc": true,
        "dev": true,
        "tmp": true
      },
      "chdir": "/opt/neebles/modules/test-module",
      "arguments": [
        "/opt/neebles/modules/test-module/runtime.py",
        "--intent",
        "open"
      ]
    },
    {
      "id": "tray-provider",
      "runtime_authority": "modules.runtime",
      "world": "modules.python3.13-tk",
      "execution": "persistent",
      "session": true,
      "dynamic_readonly": [
        {
          "authority": "modules.installed_runtime",
          "source": "/opt/neebles/modules/test-module",
          "destination": "/opt/neebles/modules/test-module"
        }
      ],
      "mounts": {
        "proc": true,
        "dev": true,
        "tmp": true
      },
      "chdir": "/opt/neebles/modules/test-module",
      "arguments": [
        "/opt/neebles/modules/test-module/tray/tray-provider.py"
      ],
      "session_readonly": [
        "neebles/tray.sock"
      ]
    }
  ]
}
