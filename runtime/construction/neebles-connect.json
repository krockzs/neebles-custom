{
  "schema": "1",
  "name": "neebles-domestic-construction",
  "subject": "neebles-connect",
  "rootfs": {
    "rust-qt": {
      "domination": {
        "world": "modules.rust-qt"
      }
    }
  },
  "steps": [
    {
      "id": "init",
      "runtime_authority": "boss.runtime",
      "world": "boss.git",
      "writable": [
        {
          "authority": "neebles.domestic_workspace",
          "source": "/opt/neebles-build/modules",
          "destination": "/work/modules"
        }
      ],
      "mounts": {
        "proc": true,
        "dev": true,
        "tmp": true
      },
      "chdir": "/work/modules",
      "arguments": [
        "init",
        "/work/modules/neebles-connect"
      ],
      "session": false,
      "execution": "foreground"
    },
    {
      "id": "fetch",
      "runtime_authority": "boss.runtime",
      "world": "boss.git",
      "readonly": [
        "system.dns_resolver_config"
      ],
      "writable": [
        {
          "authority": "neebles.domestic_workspace",
          "source": "/opt/neebles-build/modules",
          "destination": "/work/modules"
        }
      ],
      "mounts": {
        "proc": true,
        "dev": true,
        "tmp": true
      },
      "chdir": "/work/modules",
      "arguments": [
        "-C",
        "/work/modules/neebles-connect",
        "fetch",
        "--depth",
        "1",
        "https://github.com/krockzs/neebles-connect.git",
        "8ce50796ba5a450332ecb5ed4697229a602457be"
      ],
      "session": false,
      "execution": "foreground"
    },
    {
      "id": "checkout",
      "runtime_authority": "boss.runtime",
      "world": "boss.git",
      "writable": [
        {
          "authority": "neebles.domestic_workspace",
          "source": "/opt/neebles-build/modules",
          "destination": "/work/modules"
        }
      ],
      "mounts": {
        "proc": true,
        "dev": true,
        "tmp": true
      },
      "chdir": "/work/modules",
      "arguments": [
        "-C",
        "/work/modules/neebles-connect",
        "checkout",
        "--detach",
        "8ce50796ba5a450332ecb5ed4697229a602457be"
      ],
      "session": false,
      "execution": "foreground"
    },
    {
      "id": "open-runtime",
      "runtime_authority": "modules.runtime",
      "rootfs": "rust-qt",
      "world": "modules.rust-qt",
      "execution": "persistent",
      "session": true,
      "readonly": [
        "boss.modules.ipc"
      ],
      "dynamic_readonly": [
        {
          "authority": "modules.installed_runtime",
          "source": "/opt/neebles/modules/neebles-connect",
          "destination": "/opt/neebles/modules/neebles-connect"
        }
      ],
      "mounts": {
        "proc": true,
        "dev": true,
        "tmp": true
      },
      "chdir": "/opt/neebles/modules/neebles-connect",
      "arguments": [
        "/opt/neebles/modules/neebles-connect/runtime/neebles-connect",
        "--intent",
        "open"
      ]
    }
  ]
}
